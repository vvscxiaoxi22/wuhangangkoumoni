                            <ui:Button class="teacher-fault-list-row">
                                <ui:Label text="05" class="teacher-fault-col-index teacher-fault-row-index" />
                                <ui:Label text="联动台无直流供电" class="teacher-fault-col-phenomenon teacher-fault-row-primary" />
                                <ui:Label text="8" class="teacher-fault-col-line teacher-fault-row-code" />
                                <ui:Label text="QF61:02--XO:13" class="teacher-fault-col-point teacher-fault-row-code" />
                            </ui:Button>
                        </ui:ScrollView>
                        <ui:Label text="列表支持纵向滚动 · 点击题目可多选或取消选择" class="teacher-fault-list-caption" />
