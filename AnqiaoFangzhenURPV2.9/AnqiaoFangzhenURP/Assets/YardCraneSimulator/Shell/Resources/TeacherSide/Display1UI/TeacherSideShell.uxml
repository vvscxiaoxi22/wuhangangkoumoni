                                <ui:Label text="03" class="teacher-fault-col-index teacher-fault-row-index" />
                                <ui:Label text="各抱闸机构缺相（注意观察各FR热继电器）" class="teacher-fault-col-phenomenon teacher-fault-row-primary" />
                                <ui:Label text="4L01" class="teacher-fault-col-line teacher-fault-row-code" />
                                <ui:Label text="QF50:02--X0:05" class="teacher-fault-col-point teacher-fault-row-code" />
                            </ui:Button>
                            <ui:Button class="teacher-fault-list-row">
                                <ui:Label text="04" class="teacher-fault-col-index teacher-fault-row-index" />
                                <ui:Label text="俯仰、小车、起升、大车控制线路无供电" class="teacher-fault-col-phenomenon teacher-fault-row-primary" />
                                <ui:Label text="1" class="teacher-fault-col-line teacher-fault-row-code" />
                                <ui:Label text="KMO3:2--X0:09" class="teacher-fault-col-point teacher-fault-row-code" />
