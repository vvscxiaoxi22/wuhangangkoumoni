                                    <ui:Label text="左右倾故障" />
                                    <ui:Label text="06" class="teacher-fault-category-count" style="-unity-text-align: middle-center;" />
                                </ui:Button>
                                <ui:Button class="teacher-fault-category-button">
                                    <ui:Label text="平面回转故障" />
                                    <ui:Label text="04" class="teacher-fault-category-count" style="-unity-text-align: middle-center;" />
                                </ui:Button>
