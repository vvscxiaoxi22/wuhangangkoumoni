<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/YardCraneSimulator/Shell/Resources/TeacherSide/Display2UI/TeacherSideLowerStyles.uss?fileID=7433441132597879392&amp;guid=8835ec8995ca4e95b59f98cceee70288&amp;type=3#TeacherSideLowerStyles" />
    <ui:VisualElement name="teacher-side-lower" class="teacher-lower-shell">
        <ui:VisualElement picking-mode="Ignore" class="teacher-lower-background" style="background-image: url(&quot;project://database/Assets/YardCraneSimulator/Art/UI/StudentHome/DesignPackage_v1/Background/student-home-background-v1.png?fileID=2800000&amp;guid=ffb6e6b80393a704fada72b1fff8f9d6&amp;type=3#student-home-background-v1&quot;);" />
        <ui:VisualElement picking-mode="Ignore" class="teacher-lower-tone" />
        <ui:VisualElement picking-mode="Ignore" class="teacher-lower-glow" />
        <ui:VisualElement picking-mode="Ignore" class="teacher-lower-brand">
            <ui:VisualElement class="teacher-lower-logo" />
            <ui:Label text="YARD CRANE / TEACHING CONSOLE" class="teacher-lower-code" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="teacher-lower-copy">
            <ui:Label text="以教学组织训练，" class="teacher-lower-title" />
            <ui:Label text="用数据连接成长。" class="teacher-lower-title teacher-lower-accent" />
            <ui:Label text="场桥集装箱起重机仿真系统 · 教师端" class="teacher-lower-subtitle" />
            <ui:VisualElement class="teacher-lower-rule" />
