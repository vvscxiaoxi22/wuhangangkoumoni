            <ui:VisualElement picking-mode="Ignore" class="teacher-badge-glow teacher-badge-glow-inner" style="top: 2px; left: -7px;" />
            <ui:Label text="教师端" class="teacher-badge" style="-unity-text-align: middle-center;" />
