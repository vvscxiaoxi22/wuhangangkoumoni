                    <ui:VisualElement picking-mode="Ignore" class="teacher-card-glow teacher-card-glow-inner" />
                    <ui:Label text="01" picking-mode="Ignore" class="teacher-card-index" />
                    <ui:Label text="TASK MANAGEMENT" picking-mode="Ignore" class="teacher-card-eyebrow" />
                    <ui:VisualElement picking-mode="Ignore" class="teacher-card-art teacher-task-art">
