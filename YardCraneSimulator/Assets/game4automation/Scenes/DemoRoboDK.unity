    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: HeaderText
      value: RoboDK Demo
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: InfoText
      value: 'This demo shows the integration of Game4Automation and RoboDK.


        The
        RoboDK Interface is currently in BETA and will be enhanced in future releases.


        RoboDK
        is a powerful and cost-effective simulator for industrial robots and robot
        programming. No programming skills are required with RoboDK''s intuitive
        interface. You can easily program any robot offline with just a few clicks
        and RoboDK has an extensive library with over 500 robot arms.


        With
        this interface, you can use RoboDK to control the robots in your Game4Automation
        models and you can connect the RobotIO''s to Game4Automation behavior models.
        By modeling the full production line with Game4Automation and by connecting
        the real PLCs you can simulate and commission big robot cells including all
        PLCs and HMIs.


        This demo only runs with Game4Automation and the
        included RoboDK interface.


        RoboDK can be tested for free. Please
        select the download link below.'
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: Height
      value: 520
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: ButtonText
      value: Get RoboDK
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: ButtonURL
      value: https://robodk.com/download
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: Button2Text
      value: Read the documentation
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: Button2URL
      value: https://game4automation.com/documentation/current/robodk.html
      objectReference: {fileID: 0}
    - target: {fileID: 9033596211370700791, guid: 62214cde89164d048b0a0516621e24e6,
        type: 3}
      propertyPath: Image
      value: 
      objectReference: {fileID: 2800000, guid: 64a42fcf8e2934c4090cc8c02bdd4fad, type: 3}
    - target: {fileID: 9033596211370700792, guid: 62214cde89164d048b0a0516621e24e6,
