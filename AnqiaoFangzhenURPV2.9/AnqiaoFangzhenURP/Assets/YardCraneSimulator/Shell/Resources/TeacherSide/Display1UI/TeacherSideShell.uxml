                                    <ui:Label text="14" class="teacher-fault-category-count" style="-unity-text-align: middle-center;" />
                                </ui:Button>
                                <ui:Button class="teacher-fault-category-button">
                                    <ui:Label text="起升、大车机构故障" />
                                    <ui:Label text="17" class="teacher-fault-category-count" style="-unity-text-align: middle-center;" />
                                </ui:Button>
