                                <ui:Label text="010-1" class="teacher-fault-col-line teacher-fault-row-code" />
                                <ui:Label text="KM04:2--KM01:21" class="teacher-fault-col-point teacher-fault-row-code" />
                            </ui:Button>
                            <ui:Button class="teacher-fault-list-row">
                                <ui:Label text="02" class="teacher-fault-col-index teacher-fault-row-index" />
