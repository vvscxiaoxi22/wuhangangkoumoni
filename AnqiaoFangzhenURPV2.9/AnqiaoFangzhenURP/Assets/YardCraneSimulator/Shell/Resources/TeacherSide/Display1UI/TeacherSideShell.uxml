                            <ui:VisualElement class="teacher-task-row">
                                <ui:VisualElement class="teacher-task-check" />
                                <ui:VisualElement class="teacher-task-line teacher-task-line-short" />
                            </ui:VisualElement>
                            <ui:VisualElement class="teacher-task-row">
                                <ui:VisualElement class="teacher-task-check" />
                                <ui:VisualElement class="teacher-task-line" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="teacher-card-rule" />
                    <ui:Label text="任务管理" picking-mode="Ignore" class="teacher-card-title" />
                    <ui:Label text="创建、组织与发布场桥训练任务" picking-mode="Ignore" class="teacher-card-description" />
