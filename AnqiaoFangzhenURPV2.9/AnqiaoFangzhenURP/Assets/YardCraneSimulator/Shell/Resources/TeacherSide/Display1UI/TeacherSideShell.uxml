                    <ui:VisualElement picking-mode="Ignore" class="teacher-card-glow teacher-card-glow-inner" />
                    <ui:Label text="02" picking-mode="Ignore" class="teacher-card-index" />
                    <ui:Label text="ASSESSMENT ANALYTICS" picking-mode="Ignore" class="teacher-card-eyebrow" />
                    <ui:VisualElement picking-mode="Ignore" class="teacher-card-art teacher-chart-art">
                        <ui:VisualElement class="teacher-chart-axis teacher-chart-axis-y" />
                        <ui:VisualElement class="teacher-chart-axis teacher-chart-axis-x" />
                        <ui:VisualElement class="teacher-chart-bar teacher-chart-bar-one" />
                        <ui:VisualElement class="teacher-chart-bar teacher-chart-bar-two" />
                        <ui:VisualElement class="teacher-chart-bar teacher-chart-bar-three" />
                        <ui:VisualElement class="teacher-chart-trend teacher-chart-trend-one" />
                        <ui:VisualElement class="teacher-chart-trend teacher-chart-trend-two" />
                        <ui:VisualElement class="teacher-chart-dot teacher-chart-dot-one" />
                        <ui:VisualElement class="teacher-chart-dot teacher-chart-dot-two" />
                        <ui:VisualElement class="teacher-chart-dot teacher-chart-dot-three" />
